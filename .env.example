# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se commitea (ver .gitignore).
#
# ⚠️ 2026-08-06 — con la separación de backend (ver aviso al inicio de
# docs/BACKEND.md), la mayoría de estas variables están destinadas a mudarse
# al .env del backend nuevo — hoy siguen aquí porque esa migración todavía
# no pasó del todo y este repo sigue funcionando parcialmente full-stack
# (docs/BACKEND.md §13 lista el recorte que le queda a este archivo).
#
# 2026-08-13: RESEND_API_KEY, EMAIL_FROM, GEMINI_API_KEY y OPENROUTER_API_KEY
# se quitaron de aquí — auth, IA y el envío de correos ya viven 100% en el
# backend nuevo, y los únicos archivos de este repo que las leían
# (src/lib/email.ts, src/lib/openRouterClient.ts) quedaron sin ningún
# llamador real y se borraron.

# Telegram Bot — opcional, solo si usas agente_telegram.py
TELEGRAM_BOT_TOKEN=
# IDs de Telegram autorizados a usar el bot, separados por coma.
# Sin esto el bot no arranca (ver agente_telegram.py).
TELEGRAM_ALLOWED_IDS=

# URL base del sitio — usada para generar links compartibles y callbacks OAuth
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Backend NestJS separado (docs/BACKEND.md, corte en curso — ver §13 y
# "Decisiones abiertas" punto 1). Incluye el prefijo global de la API
# (/api/v1) — ver src/main.ts del backend.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# JWT — obligatorio, mínimo 32 caracteres aleatorios. La app no arranca sin
# esto (ver src/lib/auth.ts). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Con el backend separado, este valor debe ser IDÉNTICO al JWT_SECRET del
# backend (mismo .env, misma cookie httpOnly "vivevillahermosa_session") —
# es la decisión de "secreto compartido" de docs/BACKEND.md, "Decisiones
# abiertas" punto 1: el backend firma y setea la cookie, este proyecto solo
# la verifica localmente en src/proxy.ts (defensa en profundidad, edge
# runtime, sin acceso a la base de datos). Si el backend termina en un
# dominio sin relación con este, hay que revisar esa decisión.
JWT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback a registrar: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com/apps
# Callback a registrar: http://localhost:3000/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# PostHog (https://posthog.com) — analítica de producto, opcional. Sin esto
# la app funciona igual, solo sin medir uso real (ver src/instrumentation-client.ts,
# docs/PLAN-AUDITORIA-FASE1-MVP.md hallazgo #8). Crea un proyecto gratis,
# copia la "Project API Key" (empieza con phc_).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Secreto compartido con el backend nuevo, usado por dos cosas: el poller de
# desarrollo (src/instrumentation.ts, solo dev — llama a
# POST /citas/recordatorios/procesar cada minuto) y, en producción, el cron
# real (.github/workflows/citas-recordatorios.yml en el repo del backend).
# ⚠️ Debe ser IDÉNTICO al CRON_SECRET del backend — mismo patrón que
# JWT_SECRET. Ver docs/BACKEND.md §6.
CRON_SECRET=
