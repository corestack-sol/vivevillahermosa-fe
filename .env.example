# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se commitea (ver .gitignore).
#
# ⚠️ 2026-08-06 — con la separación de backend (ver aviso al inicio de
# docs/BACKEND.md), la mayoría de estas variables (JWT_SECRET, OAuth,
# RESEND_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, CRON_SECRET) están
# destinadas a mudarse al .env del backend nuevo — hoy siguen aquí porque
# esa migración todavía no pasó y este repo sigue funcionando full-stack
# (docs/BACKEND.md §13 lista el recorte que le queda a este archivo
# cuando eso ocurra: solo NEXT_PUBLIC_API_URL y NEXT_PUBLIC_BASE_URL).

# Telegram Bot — opcional, solo si usas agente_telegram.py
TELEGRAM_BOT_TOKEN=
# IDs de Telegram autorizados a usar el bot, separados por coma.
# Sin esto el bot no arranca (ver agente_telegram.py).
TELEGRAM_ALLOWED_IDS=

# URL base del sitio — usada para generar links compartibles y callbacks OAuth
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# JWT — obligatorio, mínimo 32 caracteres aleatorios. La app no arranca sin
# esto (ver src/lib/auth.ts). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback a registrar: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com/apps
# Callback a registrar: http://localhost:3000/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Resend — https://resend.com/api-keys — usado para el correo de alertas
# (ver src/lib/email.ts). Sin esto, el envío se salta con un aviso en
# consola; el resto de la app sigue funcionando normal.
RESEND_API_KEY=
# Remitente. Sin verificar un dominio propio en Resend, usa el sender de
# pruebas compartido: "Vive Villahermosa <onboarding@resend.dev>".
EMAIL_FROM=

# Protege POST /api/citas/recordatorios/procesar — sin esto, el endpoint
# queda abierto (no es grave: es idempotente y no expone datos, pero en
# producción hay que ponerlo). El cron real que lo llame debe mandar
# "Authorization: Bearer <este valor>". Ver docs/BACKEND.md §6.
CRON_SECRET=

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey — usado
# solo para analizar las fotos al publicar una propiedad (contenido
# inapropiado / que no corresponde a un inmueble, ver src/lib/aiVision.ts).
# Sin esto, el análisis se salta con un aviso en consola y las fotos se
# aceptan sin revisar — igual que el resto de la app, ninguna función de IA
# es un requisito para que la plataforma funcione.
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — usado para búsqueda inteligente,
# detección de fraude en texto, generación de descripciones de anuncio y
# resumen de reportes (ver src/lib/ai.ts). Mismo modelo que antes con Groq
# (Llama 3.3 70B), pero sin límite de tokens por día — solo un límite de
# peticiones/día (50 gratis, 1,000 tras comprar $10 USD de crédito una sola
# vez). Sin esto, cada función cae a su heurística/plantilla
# determinística — nunca bloquea al usuario.
OPENROUTER_API_KEY=
