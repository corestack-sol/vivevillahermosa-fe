# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local (SQLite de desarrollo) — nunca commitear, contiene
# datos de prueba reales (hashes de contraseña, logs de moderación, etc.)
prisma/*.db
prisma/*.db-journal

# Documentos de referencia pesados (no los necesita la app en runtime,
# solo se citan como fuente en la investigación) — el Atlas de Riesgos
# pesa 234MB, muy por encima del límite de 100MB de GitHub.
docs/*.pdf
